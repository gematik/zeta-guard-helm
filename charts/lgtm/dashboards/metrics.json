           "datasource": {
            "name": "prometheus"
           },
           "spec": {
            "editorMode": "code",
            "exemplar": false,
            "expr": "(\n    sum(rate(traces_span_metrics_duration_milliseconds_sum{\n        service_name=\"ZETA Guard PEP HTTP proxy\",\n        span_kind=\"SPAN_KIND_SERVER\",\n        span_name=\"/ASL\", is_asl=\"handle_subrequest\"}[1m]))\n  -\n    sum(rate(traces_span_metrics_duration_milliseconds_sum{\n        service_name=\"ZETA Guard PEP HTTP proxy\",\n        span_name=\"upstream\", is_asl=\"\"}[1m]))\n)\n/\n  sum(rate(traces_span_metrics_duration_milliseconds_count{\n      service_name=\"ZETA Guard PEP HTTP proxy\",\n      span_kind=\"SPAN_KIND_SERVER\",\n      span_name=\"/ASL\", is_asl=\"handle_subrequest\"}[1m]))\n",
            "instant": false,
            "legendFormat": "/ASL handle_subrequest minus inner upstream span",
            "range": true
           }
          },
          "refId": "B",
          "hidden": false
         }
        },
        {
         "kind": "PanelQuery",
         "spec": {
          "query": {
           "kind": "DataQuery",
           "group": "prometheus",
           "version": "v0",
           "datasource": {
            "name": "prometheus"
           },
           "spec": {
            "editorMode": "code",
            "exemplar": false,
            "expr": "    sum(rate(traces_span_metrics_duration_milliseconds_sum{\n            service_name=\"ZETA Guard PEP HTTP proxy\",\n            span_name=\"upstream\", is_asl=\"handle_subrequest\"}[1m]))\n/\n    sum(rate(traces_span_metrics_duration_milliseconds_count{\n            service_name=\"ZETA Guard PEP HTTP proxy\",\n            span_name=\"upstream\", is_asl=\"handle_subrequest\"}[1m]))",
            "instant": false,
            "legendFormat": "outer upstream",
            "range": true
           }
          },
          "refId": "C",
          "hidden": false
         }
        },
        {
         "kind": "PanelQuery",
         "spec": {
          "query": {
           "kind": "DataQuery",
           "group": "prometheus",
           "version": "v0",
           "datasource": {
            "name": "prometheus"
           },
           "spec": {
            "editorMode": "code",
            "exemplar": false,
            "expr": "    sum(rate(traces_span_metrics_duration_milliseconds_sum{\n          service_name=\"ZETA Guard PEP HTTP proxy\",\n          span_name=\"upstream\", is_asl=\"\"}[1m]))\n/\n    sum(rate(traces_span_metrics_duration_milliseconds_count{\n          service_name=\"ZETA Guard PEP HTTP proxy\",\n          span_name=\"upstream\", is_asl=\"\"}[1m]))",
            "instant": false,
