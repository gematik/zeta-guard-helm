   "panel-5": {
    "kind": "Panel",
    "spec": {
     "id": 5,
     "title": "pep \"self-time\" estimation",
     "description": "",
     "links": [],
     "data": {
      "kind": "QueryGroup",
      "spec": {
       "queries": [
        {
         "kind": "PanelQuery",
         "spec": {
          "query": {
           "kind": "DataQuery",
           "group": "prometheus",
           "version": "v0",
           "datasource": {
            "name": "prometheus"
           },
           "spec": {
            "editorMode": "code",
            "exemplar": false,
            "expr": "sum(rate(traces_span_metrics_duration_milliseconds_sum{\n    service_name=\"ZETA Guard PEP HTTP proxy\",\n    span_kind=\"SPAN_KIND_SERVER\",\n    span_name=\"/ASL\", is_asl=\"handle_subrequest\"}[1m]))\n    /\nsum(rate(traces_span_metrics_duration_milliseconds_count{\n    service_name=\"ZETA Guard PEP HTTP proxy\",\n    span_kind=\"SPAN_KIND_SERVER\",\n    span_name=\"/ASL\", is_asl=\"handle_subrequest\"}[1m]))",
            "instant": false,
            "interval": "",
            "legendFormat": "/ASL handle_subrequest",
            "range": true
           }
          },
          "refId": "A",
          "hidden": false
         }
