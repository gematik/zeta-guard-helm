    "kind": "Panel",
    "spec": {
     "id": 8,
     "title": "cpu throttling",
     "description": "Fraction of CFS periods in which the container was frozen by its CPU limit.",
     "links": [],
     "data": {
      "kind": "QueryGroup",
      "spec": {
       "queries": [
